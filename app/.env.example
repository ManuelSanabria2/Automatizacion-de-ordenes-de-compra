# Copiar este archivo a .env.local y completar los valores reales.
# NUNCA subir .env ni .env.local al repositorio.
# Solo variables NEXT_PUBLIC_* llegan al navegador — nada de claves privadas aquí.

# URL del backend FastAPI en local
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase (claves públicas del cliente: URL + anon key, protegidas por RLS)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-supabase-anon-key
