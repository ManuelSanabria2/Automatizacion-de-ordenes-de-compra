# Copiar este archivo a .env.local y completar los valores reales.
# NUNCA subir .env ni .env.local al repositorio.
# Solo variables NEXT_PUBLIC_* llegan al navegador — nada de claves privadas aquí.

# URL del backend FastAPI (en local http://localhost:8000; en producción la
# URL del servicio en Render)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Clave API compartida con el backend (misma que CLAVE_API_BACKEND). Vacía en
# local si el backend no la exige. Ojo: al ser NEXT_PUBLIC_* queda visible en
# el bundle del navegador — protege contra bots, no es un login real.
NEXT_PUBLIC_CLAVE_API=
