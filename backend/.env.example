# Copiar este archivo a .env y completar los valores reales.
# NUNCA subir el archivo .env al repositorio.

# Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-supabase-anon-key
# La service_role key SOLO vive en el backend (salta RLS) — nunca en el frontend
SUPABASE_SERVICE_ROLE_KEY=tu-supabase-service-role-key

# Gemini API
GEMINI_API_KEY=tu-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-lite

# Matching de productos: score mínimo (0-100) del fuzzy matching antes de
# recurrir a Gemini (opcional, default 70)
UMBRAL_FUZZY=70

# Score a partir del cual el match se pinta como "listo" en la revisión.
# Es solo informativo: nunca auto-confirma ni guarda alias (default 92)
UMBRAL_ALTA_CONFIANZA=92

# Candidatos que se devuelven por ítem a la pantalla de revisión (default 5)
MAX_CANDIDATOS=5

# Candidatos por ítem que se le muestran a Gemini cuando el fuzzy no alcanza el
# umbral. Subirlo mejora el recall y gasta más tokens (default 20)
TAMANO_SHORTLIST_GEMINI=20

# Segundos que el catálogo normalizado vive en memoria antes de releerse de
# Supabase. Las escrituras del catálogo lo invalidan solas (default 300)
TTL_CACHE_CATALOGO=300

# Clave compartida con el frontend (header X-API-Key). Vacía = endpoints SIN
# autenticación, solo aceptable en desarrollo local. En producción es
# OBLIGATORIA — generar con: openssl rand -hex 32
CLAVE_API_BACKEND=

# Orígenes permitidos por CORS, separados por comas (default
# http://localhost:3000). En producción, el dominio del frontend en Vercel.
# ORIGENES_CORS=https://tu-app.vercel.app
